---
layout: null
---
[
    {% for post in site.posts %}
        {% capture search_extra %}{{ post.short_title }} {{ post.description }} {{ post.funder }} {{ post.funder_type }} {{ post.pi }} {{ post.grant_number }} {{ post.role }} {{ post.resource_hub }} {{ post.projects | join: ' ' }}{% endcapture %}
        {
        "title"    : "{{ post.title | escape }}",
        "short_title": "{{ post.short_title | escape }}",
        "description": "{{ post.description | escape }}",
        "content"  : "{{ search_extra | append: ' ' | append: post.content | newline_to_br | strip_newlines | replace: '<br />', ' '| strip_html |  remove_chars | remove: '\'| remove:  "	" | escape }}",
        "year"     : "{{ post.date | date: "%Y" }}",
        {% if post.year and post.year != "" %}"yearpaper"  : "{{ post.year }}",
        {% elsif post.start_year %}"yearpaper"  : "{{ post.start_year }}",
        {% else %}"yearpaper"  : "{{ post.date | date: '%Y' }}",{% endif %}
        {% if post.authors and post.authors != "" %}"author"   : "{{ post.authors | escape }}",
        {% elsif post.pi %}"author"   : "{{ post.pi | escape }}",
        {% else %}"author"   : "",{% endif %}
        "category" : "{{ post.categories }}",
        {% if post.journal and post.journal != "" %}"journal"  : "{{ post.journal | escape }}",
        {% elsif post.funder and post.funder != "" %}"journal"  : "{{ post.funder | escape }}",
        {% else %}"journal"  : " ",{% endif %}
        "funder"   : "{{ post.funder | escape }}",
        "tags"     : "{{ post.tags | join: ', ' }}",
        "projects" : "{{ post.projects | join: ', ' }}",
        "url"      : "{{ site.baseurl }}{{ post.url }}"
        } {% unless forloop.last %},{% endunless %}
    {% endfor %}
]
